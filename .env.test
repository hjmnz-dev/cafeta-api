# Valores de prueba, sin secretos reales. Los usan las pruebas e2e (Vitest pone NODE_ENV=test).
NODE_ENV=test
PORT=3001
DATABASE_URL=postgresql://cafeta:cafeta@localhost:5432/cafeta_test
DIRECT_URL=postgresql://cafeta:cafeta@localhost:5432/cafeta_test
JWT_SECRET=solo-para-pruebas-no-usar-en-produccion-000000
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
ALLOWED_EMAIL_DOMAINS=est.intec.edu.do,intec.edu.do
# Alto para que las e2e no choquen con el límite; el 429 se verifica con el valor por defecto.
AUTH_RATE_LIMIT=1000
