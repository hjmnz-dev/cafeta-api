# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
PORT=3000

# Local: la base de docker-compose. En Supabase: el pooler en modo sesión (puerto 5432).
DATABASE_URL=postgresql://cafeta:cafeta@localhost:5432/cafeta
# Migraciones. En local, igual a DATABASE_URL; en Supabase, la misma del pooler en modo sesión.
DIRECT_URL=postgresql://cafeta:cafeta@localhost:5432/cafeta

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# Semilla (npm run db:seed). Solo la lee prisma/seed.ts, no la API.
# SEED_DEMO=true carga la demo del prototipo; en producción no se define (solo carreras y admin).
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@intec.edu.do
# Al menos 12 caracteres. En producción va como secreto, nunca en el repo.
SEED_ADMIN_PASSWORD=cambia-esta-clave-admin
# Contraseña común de los usuarios de demo (requerida con SEED_DEMO=true).
SEED_DEMO_PASSWORD=cafeta-demo-2026

# Registro y login (spec 0004).
ALLOWED_EMAIL_DOMAINS=est.intec.edu.do,intec.edu.do
# Intentos por minuto por IP en registro y login.
AUTH_RATE_LIMIT=5
